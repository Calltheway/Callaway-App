# ─────────────────────────────────────────────────────────────────
# ORACLE — Local Development Environment
# Fill in ANTHROPIC_API_KEY to enable the AI chat feature.
# All other values are optional for local demo mode.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED for AI Chat ──────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── OPTIONAL — Supabase (auth + database) ─────────────────────────
# Without these the app runs in demo mode with mock data.
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_key

# ── OPTIONAL — Plaid (real bank connections) ──────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── OPTIONAL — Stripe (payments) ─────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
