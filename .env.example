# ─────────────────────────────────────────────────────────────────
# KEEPER — Environment Variables
#
# HOW TO USE:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your real values below
# 3. Never commit .env.local — it's in .gitignore
#
# Variables starting with NEXT_PUBLIC_ are visible in the browser.
# Variables WITHOUT that prefix are server-only (API routes only).
# Claude/Plaid/Stripe secrets are server-only for security.
# ─────────────────────────────────────────────────────────────────

# ── SUPABASE ──────────────────────────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── ANTHROPIC / CLAUDE ────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
# Server-only — never exposed to the browser
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── PLAID ─────────────────────────────────────────────────────────
# Get from: https://dashboard.plaid.com → Team Settings → Keys
# Use "sandbox" for testing (fake data, free)
# Server-only — your secret is never in the browser
PLAID_CLIENT_ID=YOUR_PLAID_CLIENT_ID
PLAID_SECRET=YOUR_PLAID_SANDBOX_SECRET
PLAID_ENV=sandbox

# ── STRIPE (payments — replaces RevenueCat on web) ────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys
# Server-only
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE

# ── GOOGLE / GMAIL (optional — email scanning) ───────────────────
# Get from: https://console.cloud.google.com → Credentials → OAuth 2.0
# Enable Gmail API, set redirect URI to: http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── MICROSOFT / OUTLOOK (optional — email scanning) ──────────────
# Get from: https://portal.azure.com → App registrations
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_CLIENT_SECRET
