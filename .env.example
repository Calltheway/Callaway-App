# ─────────────────────────────────────────────────────────────────
# KEEPER — Environment Variables
#
# HOW TO USE THIS FILE:
# 1. Copy this file and rename it to ".env"  (remove the .example part)
# 2. Fill in each value below with your real API keys
# 3. Never commit your .env file to git — it's already in .gitignore
# 4. Every variable that starts with EXPO_PUBLIC_ is visible in the
#    app code. Never put private server secrets in EXPO_PUBLIC_ vars.
# ─────────────────────────────────────────────────────────────────

# ── SUPABASE ──────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
# The URL looks like: https://abcdefghij.supabase.co
# The anon key is safe to expose in the app (RLS protects data)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── ANTHROPIC / CLAUDE ────────────────────────────────────────────
# Get this from: https://console.anthropic.com → API Keys
# WARNING: In production, move this to a server-side function so
# the key is never exposed in the app bundle. For development only.
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── PLAID ─────────────────────────────────────────────────────────
# Get these from: https://dashboard.plaid.com → Team Settings → Keys
# Use "sandbox" for testing (free, uses fake bank data)
# Use "development" when testing with real bank accounts (requires approval)
# Use "production" when live on App Store (requires approval + business info)
EXPO_PUBLIC_PLAID_CLIENT_ID=YOUR_PLAID_CLIENT_ID
EXPO_PUBLIC_PLAID_SECRET=YOUR_PLAID_SANDBOX_SECRET
EXPO_PUBLIC_PLAID_ENV=sandbox
# Optional: set this to receive transaction update notifications
EXPO_PUBLIC_PLAID_WEBHOOK_URL=

# ── REVENUECAT ────────────────────────────────────────────────────
# Get these from: https://app.revenuecat.com → Your App → API Keys
# You need a separate key for iOS and Android
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_IOS_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_ANDROID_KEY

# ── GOOGLE / GMAIL API ────────────────────────────────────────────
# Get this from: https://console.cloud.google.com → Credentials → OAuth 2.0
# You need to enable the Gmail API and create OAuth credentials
# Redirect URI: keeper://auth/google
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── MICROSOFT / OUTLOOK API ───────────────────────────────────────
# Get this from: https://portal.azure.com → App registrations → New registration
# You need to enable the Mail.Read permission
# Redirect URI: keeper://auth/microsoft
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_CLIENT_ID

# ── TWILIO (Voice AI negotiations — Keeper+ only) ─────────────────
# Get these from: https://console.twilio.com → Account → API Keys
EXPO_PUBLIC_TWILIO_ACCOUNT_SID=AC_YOUR_ACCOUNT_SID
EXPO_PUBLIC_TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN
EXPO_PUBLIC_TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── ELEVENLABS (Voice AI — Keeper+ only) ──────────────────────────
# Get this from: https://elevenlabs.io → Profile → API Key
EXPO_PUBLIC_ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=YOUR_VOICE_ID
